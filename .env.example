# URL del webhook que recibe el formulario de contacto (Zapier, Make, n8n, etc.).
# El sitio es estático y no tiene backend propio: el formulario hace un POST
# directo a esta URL desde el navegador. Debe empezar por PUBLIC_ para que
# Astro la incluya en el bundle del cliente.
#
# Copia este archivo a .env y añade la URL real, o configúrala como variable
# de entorno en Netlify / Vercel (Site settings → Environment variables).
PUBLIC_CONTACT_WEBHOOK_URL=https://example.com/webhook/flujoteca-contacto
