---
import { flowDemo } from "../content/site";

const { steps, decision, final } = flowDemo;
---

<section id="ejemplo" class="reveal border-b border-borde bg-hueso">
  <div class="container-page py-16 sm:py-20">
    <div class="max-w-2xl">
      <p
        class="inline-flex border border-borde px-2 py-0.5 font-mono text-xs tracking-wide text-tinta-suave uppercase"
      >
        {flowDemo.badge}
      </p>
      <h2 class="mt-3 font-display text-2xl font-bold text-tinta sm:text-3xl">{flowDemo.title}</h2>
      <p class="mt-3 text-tinta-suave">{flowDemo.subtitle}</p>
    </div>

    <ol class="mx-auto mt-12 max-w-2xl">
      {
        steps.map((step, index) => (
          <li>
            <div class="border border-borde bg-superficie px-5 py-4">
              <p class="font-mono text-xs text-senal">{String(index + 1).padStart(2, "0")}</p>
              <h3 class="mt-1 font-display text-lg font-bold text-tinta">{step.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-tinta-suave">{step.description}</p>
            </div>
            <p class="py-2 text-center font-mono text-senal" aria-hidden="true">↓</p>
          </li>
        ))
      }

      <li>
        <div class="border-2 border-tinta bg-superficie px-5 py-4 text-center">
          <h3 class="font-display text-lg font-bold text-tinta">{decision.question}</h3>
        </div>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div class="border border-urgencia bg-superficie px-5 py-4">
            <p class="font-mono text-xs font-medium text-urgencia uppercase">
              {decision.yes.label} →
            </p>
            <h3 class="mt-1 font-display text-lg font-bold text-tinta">{decision.yes.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-tinta-suave">{decision.yes.description}</p>
          </div>
          <div class="border border-confirma bg-superficie px-5 py-4">
            <p class="font-mono text-xs font-medium text-confirma uppercase">
              {decision.no.label} →
            </p>
            <h3 class="mt-1 font-display text-lg font-bold text-tinta">{decision.no.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-tinta-suave">{decision.no.description}</p>
          </div>
        </div>
        <p class="py-2 text-center font-mono text-senal" aria-hidden="true">↓</p>
      </li>

      <li>
        <div class="border-2 border-confirma bg-superficie px-5 py-4 text-center">
          <h3 class="font-display text-lg font-bold text-tinta">{final.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-tinta-suave">{final.description}</p>
        </div>
      </li>
    </ol>
  </div>
</section>
