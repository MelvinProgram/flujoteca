---
import { technology } from "../content/site";
import Reveal from "./Reveal.astro";
---

<section id="herramientas" class="border-b border-borde bg-hueso">
  <div class="container-page py-16 sm:py-20">
    <Reveal class="max-w-2xl">
      <h2 class="font-display text-2xl font-bold text-tinta sm:text-3xl">{technology.title}</h2>
      <p class="mt-3 leading-relaxed text-tinta-suave">{technology.body}</p>
    </Reveal>

    <ul class="mt-8 flex flex-wrap gap-2">
      {
        technology.items.map((item, i) => (
          <Reveal
            as="li"
            distance={12}
            duration={500}
            delay={Math.min(i, 8) * 40}
            class="border border-borde bg-superficie px-3 py-1.5 font-mono text-xs text-tinta-suave"
          >
            {item}
          </Reveal>
        ))
      }
    </ul>

    <Reveal as="p" delay={150} class="mt-6 text-sm text-tinta-suave">{technology.note}</Reveal>
  </div>
</section>
