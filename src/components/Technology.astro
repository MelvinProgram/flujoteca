---
import { technology } from "../content/site";
---

<section id="herramientas" class="reveal border-b border-borde bg-hueso">
  <div class="container-page py-16 sm:py-20">
    <div class="max-w-2xl">
      <h2 class="font-display text-2xl font-bold text-tinta sm:text-3xl">{technology.title}</h2>
      <p class="mt-3 leading-relaxed text-tinta-suave">{technology.body}</p>
    </div>

    <ul class="mt-8 flex flex-wrap gap-2">
      {
        technology.items.map((item) => (
          <li class="border border-borde bg-superficie px-3 py-1.5 font-mono text-xs text-tinta-suave">
            {item}
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-sm text-tinta-suave">{technology.note}</p>
  </div>
</section>
