---
import { hero } from "../content/site";
---

<section id="inicio" class="relative border-b border-borde bg-hueso">
  <!-- Sello de registro: firma visual del sitio, evoca un sello de entrada administrativo -->
  <div
    class="absolute top-5 right-4 z-10 sm:top-8 sm:right-8 lg:right-12"
    aria-hidden="true"
  >
    <div class="registro-stamp text-tinta">
      <span class="registro-stamp-ring"></span>
      <span class="text-[10px] sm:text-xs">FLUJOTECA</span>
      <span class="text-[8px] sm:text-[9px]">DIAGNÓSTICO&nbsp;GRATUITO</span>
    </div>
  </div>

  <div class="container-page py-24 sm:py-32 lg:py-40">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-mono text-xs font-medium tracking-widest text-senal uppercase">
        {hero.kicker}
      </p>

      <h1 class="mt-5 font-display text-4xl font-bold text-tinta sm:text-5xl lg:text-6xl">
        {hero.title}
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-balance text-lg leading-relaxed text-tinta-suave">
        {hero.subtitle}
      </p>

      <div class="mt-10 flex flex-col items-center gap-3">
        <a
          href={hero.cta.href}
          class="inline-flex items-center justify-center border border-senal bg-senal px-8 py-3.5 font-sans text-base font-medium text-blanco transition-colors hover:bg-tinta-fija hover:border-tinta-fija"
        >
          {hero.cta.label}
        </a>
        <p class="font-mono text-xs text-tinta-suave">{hero.meta}</p>
      </div>
    </div>
  </div>
</section>
