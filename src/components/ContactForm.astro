---
import { contactForm } from "../content/site";

const { fields, consent } = contactForm;
---

<section id="contacto" class="bg-hueso">
  <div class="container-page py-16 sm:py-20">
    <div data-reveal-group class="mx-auto max-w-xl">
      <div class="text-center">
        <h2 class="font-display text-2xl font-bold text-tinta sm:text-3xl">
          {contactForm.title}
        </h2>
        <p class="mt-3 text-tinta-suave">{contactForm.subtitle}</p>
        <p class="mt-2 font-mono text-xs text-tinta-suave">{contactForm.note}</p>
      </div>

      <div
        id="form-success"
        class="mt-10 hidden border border-confirma bg-superficie p-6 text-center sm:p-8"
        role="status"
        tabindex="-1"
      >
        <h3 class="font-display text-2xl font-bold text-confirma">{contactForm.success.title}</h3>
        <p class="mt-3 text-tinta">{contactForm.success.body}</p>
        <p class="mt-2 text-sm text-tinta-suave">{contactForm.success.next}</p>
      </div>

      <form id="contact-form" class="relative mt-10 space-y-5 border border-borde bg-superficie p-6 sm:p-8">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="block font-mono text-xs uppercase tracking-wide text-tinta-suave">
              <span class="text-senal">01</span> · {fields.name.label}
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              placeholder={fields.name.placeholder}
              class="mt-1.5 w-full border border-borde bg-superficie px-3 py-2.5 text-tinta placeholder:text-tinta-suave/80 focus:border-senal"
            />
          </div>

          <div>
            <label for="email" class="block font-mono text-xs uppercase tracking-wide text-tinta-suave">
              <span class="text-senal">02</span> · {fields.email.label}
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder={fields.email.placeholder}
              class="mt-1.5 w-full border border-borde bg-superficie px-3 py-2.5 text-tinta placeholder:text-tinta-suave/80 focus:border-senal"
            />
          </div>

          <div>
            <label for="phone" class="block font-mono text-xs uppercase tracking-wide text-tinta-suave">
              <span class="text-senal">03</span> · {fields.phone.label}
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              autocomplete="tel"
              placeholder={fields.phone.placeholder}
              class="mt-1.5 w-full border border-borde bg-superficie px-3 py-2.5 text-tinta placeholder:text-tinta-suave/80 focus:border-senal"
            />
          </div>

          <div>
            <label for="company" class="block font-mono text-xs uppercase tracking-wide text-tinta-suave">
              <span class="text-senal">04</span> · {fields.company.label}
            </label>
            <input
              type="text"
              id="company"
              name="company"
              autocomplete="organization"
              placeholder={fields.company.placeholder}
              class="mt-1.5 w-full border border-borde bg-superficie px-3 py-2.5 text-tinta placeholder:text-tinta-suave/80 focus:border-senal"
            />
          </div>
        </div>

        <div>
          <label for="process" class="block font-mono text-xs uppercase tracking-wide text-tinta-suave">
            <span class="text-senal">05</span> · {fields.process.label}
          </label>
          <select
            id="process"
            name="process"
            class="mt-1.5 w-full border border-borde bg-superficie px-3 py-2.5 text-tinta focus:border-senal"
          >
            <option value="">{fields.process.placeholder}</option>
            {fields.process.options.map((option) => <option value={option}>{option}</option>)}
          </select>
        </div>

        <div>
          <label for="message" class="block font-mono text-xs uppercase tracking-wide text-tinta-suave">
            <span class="text-senal">06</span> · {fields.message.label}
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder={fields.message.placeholder}
            class="mt-1.5 w-full resize-y border border-borde bg-superficie px-3 py-2.5 text-tinta placeholder:text-tinta-suave/80 focus:border-senal"
          ></textarea>
        </div>

        <!-- Anti-spam: campo señuelo, invisible para personas y lectores de pantalla -->
        <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
          <label for="website">No rellenar</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex items-start gap-2.5">
          <input
            type="checkbox"
            id="consent"
            name="consent"
            required
            class="mt-0.5 h-5 w-5 shrink-0 border border-borde accent-senal"
          />
          <label for="consent" class="text-sm text-tinta-suave">
            {consent.text}
            {" "}
            <a href={consent.linkHref} class="text-senal underline underline-offset-2">
              {consent.linkLabel}
            </a>.
          </label>
        </div>

        <button
          type="submit"
          class="w-full border border-tinta-fija bg-tinta-fija px-6 py-3.5 font-sans text-base font-medium text-blanco transition-colors hover:bg-senal hover:border-senal disabled:cursor-not-allowed disabled:opacity-60"
        >
          {contactForm.submitLabel}
        </button>

        <p id="form-status" class="text-center text-sm" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  import { contactForm, hubspot } from "../content/site";
  import { track } from "../lib/track";

  const ENDPOINT = `https://api-${hubspot.hublet}.hsforms.com/submissions/v3/integration/submit/${hubspot.portalId}/${hubspot.formGuid}`;

  function getHutk(): string | undefined {
    const match = document.cookie.match(/(?:^|;\s*)hubspotutk=([^;]+)/);
    return match ? decodeURIComponent(match[1]) : undefined;
  }

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLParagraphElement>("#form-status");
  const successPanel = document.querySelector<HTMLDivElement>("#form-success");
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status || !submitButton) return;

    submitButton.disabled = true;
    submitButton.textContent = contactForm.submittingLabel;
    status.textContent = "";
    status.classList.remove("text-urgencia", "text-confirma");

    const data = Object.fromEntries(new FormData(form).entries());

    const showSuccess = () => {
      form.classList.add("hidden");
      successPanel?.classList.remove("hidden");
      successPanel?.focus();
      form.reset();
    };

    // Honeypot relleno => bot: simulamos éxito sin enviar nada a ningún proveedor
    if (String(data.website ?? "")) {
      showSuccess();
      return;
    }

    const fields: { name: string; value: string }[] = [];
    const addField = (key: keyof typeof hubspot.fieldMap, value: string) => {
      if (value) fields.push({ name: hubspot.fieldMap[key], value });
    };

    addField("firstname", String(data.name ?? ""));
    addField("email", String(data.email ?? ""));
    addField("phone", String(data.phone ?? ""));
    addField("company", String(data.company ?? ""));
    // El proceso elegido se antepone al mensaje: así no hace falta una propiedad nueva en HubSpot
    const processChoice = String(data.process ?? "");
    const freeText = String(data.message ?? "");
    addField("message", [processChoice && `Proceso de interés: ${processChoice}`, freeText].filter(Boolean).join("\n\n"));

    const hutk = getHutk();

    const body = {
      fields,
      context: {
        pageUri: window.location.href,
        pageName: document.title,
        ...(hutk ? { hutk } : {}),
      },
      ...(hubspot.gdprConsentEnabled
        ? {
            legalConsentOptions: {
              consent: {
                consentToProcess: true,
                text: `${contactForm.consent.text} ${contactForm.consent.linkLabel}.`,
              },
            },
          }
        : {}),
    };

    try {
      const response = await fetch(ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });

      if (!response.ok) {
        const errorBody = await response.text().catch(() => "");
        throw new Error(`HubSpot respondió ${response.status}: ${errorBody}`);
      }

      track("form_submit", { process: processChoice || "sin_especificar" });

      // Email de confirmación (Brevo): solo si el envío al CRM ha ido bien
      fetch("/.netlify/functions/send-confirmation", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: String(data.name ?? ""), email: String(data.email ?? "") }),
      }).catch((error) => {
        console.error("Error al enviar el email de confirmación:", error);
      });

      showSuccess();
    } catch (error) {
      console.error("Error al enviar el formulario de contacto:", error);
      status.textContent = contactForm.errorMessage;
      status.classList.add("text-urgencia");
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = contactForm.submitLabel;
    }
  });
</script>
