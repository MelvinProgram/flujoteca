---
import { site, footer, creator } from "../content/site";
---

<footer class="border-t border-borde bg-superficie">
  <div class="container-page grid gap-8 py-12 sm:grid-cols-2">
    <div>
      <div class="flex items-center gap-2">
        <img src="/logo.png" alt={site.name} class="h-6 w-auto dark:hidden" width="662" height="200" />
        <img
          src="/logo-dark.png"
          alt={site.name}
          class="hidden h-6 w-auto dark:block"
          width="662"
          height="200"
        />
      </div>
      <p class="mt-2 max-w-sm text-sm text-tinta-suave">{site.tagline}</p>

      <dl class="mt-4 space-y-1 font-mono text-sm text-tinta-suave">
        <div class="flex gap-2">
          <dt class="sr-only">Email</dt>
          <dd>
            <a href={`mailto:${site.contact.email}`} class="hover:text-senal">
              {site.contact.email}
            </a>
          </dd>
        </div>
        <div class="flex gap-2">
          <dt class="sr-only">Zona de servicio</dt>
          <dd>{site.contact.address}</dd>
        </div>
      </dl>
    </div>

    <div class="sm:text-right">
      <nav class="flex flex-col gap-2 sm:items-end" aria-label="Enlaces legales">
        {
          footer.legalLinks.map((link) => (
            <a href={link.href} class="text-sm text-tinta-suave hover:text-senal">
              {link.label}
            </a>
          ))
        }
      </nav>
      <p class="mt-4 font-mono text-xs text-tinta-suave">{footer.copyright}</p>
    </div>
  </div>

  <div class="container-page mt-8 flex flex-col items-center gap-3 border-t border-borde pt-6 sm:flex-row sm:justify-between">
    <div class="flex items-center gap-3">
      <img
        src={creator.photo}
        alt={creator.name}
        class="h-10 w-10 rounded-full border border-borde object-cover"
        width="80"
        height="80"
      />
      <div>
        <p class="font-sans text-sm font-medium text-tinta">{creator.name}</p>
        <p class="text-xs text-tinta-suave">{creator.role}</p>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <a
        href={creator.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`LinkedIn de ${creator.name}`}
        class="text-tinta-suave transition-colors hover:text-senal"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.114 20.452H3.56V9h3.554v11.452z"
          ></path>
        </svg>
      </a>
      <a
        href={creator.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`GitHub de ${creator.name}`}
        class="text-tinta-suave transition-colors hover:text-senal"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.833.09-.647.35-1.088.636-1.339-2.221-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.548 9.548 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.026 2.747-1.026.546 1.378.203 2.397.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.848-2.338 4.695-4.566 4.943.359.31.678.921.678 1.856 0 1.34-.012 2.421-.012 2.75 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</footer>
