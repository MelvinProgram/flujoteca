---
import { howItWorks } from "../content/site";
---

<section id="como-funciona" class="reveal border-b border-borde bg-hueso">
  <div class="container-page py-16 sm:py-20">
    <h2 class="font-display text-2xl font-bold text-tinta sm:text-3xl">{howItWorks.title}</h2>

    <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-5 lg:gap-0 lg:divide-x lg:divide-borde">
      {
        howItWorks.steps.map((step) => (
          <li class="lg:px-5 first:lg:pl-0 last:lg:pr-0">
            <p class="font-mono text-sm text-senal">{step.number}</p>
            <h3 class="mt-2 font-display text-xl font-bold text-tinta">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-tinta-suave">{step.description}</p>
          </li>
        ))
      }
    </ol>

    <p class="mt-12 max-w-2xl border-l-4 border-senal pl-4 font-display text-lg text-tinta">
      {howItWorks.closing}
    </p>
  </div>
</section>
