---
import { howItWorks } from "../content/site";
---

<section id="como-funciona" class="border-b border-borde bg-hueso">
  <div class="container-page py-16 sm:py-20">
    <h2 class="font-display text-2xl font-semibold text-tinta sm:text-3xl">{howItWorks.title}</h2>

    <ol class="mt-10 grid gap-10 sm:grid-cols-3 sm:gap-8">
      {
        howItWorks.steps.map((step) => (
          <li>
            <p class="font-mono text-sm text-senal">{step.number}</p>
            <h3 class="mt-2 font-display text-xl font-semibold text-tinta">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-tinta-suave">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
