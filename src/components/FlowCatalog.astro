---
import { flows } from "../content/site";
---

<section id="flujoteca" class="reveal">
  <div class="container-page py-16 sm:py-20">
    <div class="max-w-2xl">
      <h2 class="font-display text-2xl font-bold text-tinta sm:text-3xl">{flows.title}</h2>
      <p class="mt-3 text-tinta-suave">{flows.subtitle}</p>
    </div>

    <ul class="mt-12 grid gap-x-4 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        flows.items.map((flow) => (
          <li
            data-track="flow_card_click"
            data-track-label={flow.code}
            class="vidrio relative flex flex-col gap-4 px-6 pt-8 pb-6"
          >
            {/* Pestaña de ficha: sobresale del borde superior, como un separador de fichero */}
            <span
              class:list={[
                "absolute -top-3 left-6 rounded-sm border px-2 py-0.5 font-mono text-xs font-medium",
                flow.code === "F-02"
                  ? "border-urgencia bg-urgencia text-hueso-fija dark:border-urgencia-texto dark:bg-urgencia-texto dark:text-tinta-fija"
                  : "border-tinta bg-hueso text-tinta",
              ]}
            >
              {flow.code}
            </span>
            <h3 class="font-display text-lg font-bold text-tinta">{flow.name}</h3>

            <dl class="space-y-3 text-sm leading-relaxed">
              <div>
                <dt class="font-mono text-[11px] tracking-wide text-urgencia-texto uppercase">
                  {flows.labels.problem}
                </dt>
                <dd class="mt-0.5 text-tinta-suave">{flow.problem}</dd>
              </div>
              <div>
                <dt class="font-mono text-[11px] tracking-wide text-senal uppercase">
                  {flows.labels.automates}
                </dt>
                <dd class="mt-0.5 text-tinta-suave">{flow.automates}</dd>
              </div>
              <div class="border-t border-borde pt-3">
                <dt class="font-mono text-[11px] tracking-wide text-confirma uppercase">
                  {flows.labels.result}
                </dt>
                <dd class="mt-0.5 text-tinta">{flow.result}</dd>
              </div>
            </dl>

            {flow.code === flows.demo.code && (
              <a
                href={flows.demo.href}
                data-track="demo_f03_click"
                data-track-label="flow-card"
                class="mt-auto inline-flex items-center justify-between gap-2 rounded-md border border-senal px-3 py-2 text-sm font-medium text-senal transition-colors hover:bg-senal hover:text-blanco dark:hover:text-tinta-fija"
              >
                <span>{flows.demo.label}</span>
                <span class="font-mono text-[11px] uppercase">{flows.demo.note}</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
