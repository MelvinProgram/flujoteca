---
import { flows } from "../content/site";
import Reveal from "./Reveal.astro";
---

<section id="flujoteca" class="border-b border-borde bg-hueso">
  <div class="container-page py-16 sm:py-20">
    <Reveal class="max-w-2xl">
      <h2 class="font-display text-2xl font-bold text-tinta sm:text-3xl">{flows.title}</h2>
      <p class="mt-3 text-tinta-suave">{flows.subtitle}</p>
    </Reveal>

    <ul class="mt-12 grid gap-x-4 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        flows.items.map((flow, i) => (
          <Reveal
            as="li"
            delay={(i % 3) * 100}
            data-track="flow_card_click"
            data-track-label={flow.code}
            class="relative flex flex-col gap-4 border border-borde bg-superficie px-6 pt-8 pb-6 shadow-[2px_2px_0_0_var(--color-borde)]"
          >
            {/* Pestaña de ficha: sobresale del borde superior, como un separador de fichero */}
            <span
              class:list={[
                "absolute -top-3 left-6 border px-2 py-0.5 font-mono text-xs font-medium",
                flow.code === "F-02"
                  ? "border-urgencia bg-urgencia text-hueso-fija"
                  : "border-tinta bg-hueso text-tinta",
              ]}
            >
              {flow.code}
            </span>
            <h3 class="font-display text-lg font-bold text-tinta">{flow.name}</h3>

            <dl class="space-y-3 text-sm leading-relaxed">
              <div>
                <dt class="font-mono text-[11px] tracking-wide text-urgencia uppercase">
                  {flows.labels.problem}
                </dt>
                <dd class="mt-0.5 text-tinta-suave">{flow.problem}</dd>
              </div>
              <div>
                <dt class="font-mono text-[11px] tracking-wide text-senal uppercase">
                  {flows.labels.automates}
                </dt>
                <dd class="mt-0.5 text-tinta-suave">{flow.automates}</dd>
              </div>
              <div class="border-t border-borde pt-3">
                <dt class="font-mono text-[11px] tracking-wide text-confirma uppercase">
                  {flows.labels.result}
                </dt>
                <dd class="mt-0.5 text-tinta">{flow.result}</dd>
              </div>
            </dl>
          </Reveal>
        ))
      }
    </ul>
  </div>
</section>
