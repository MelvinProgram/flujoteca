---
import { flows } from "../content/site";
---

<section id="flujoteca" class="border-b border-borde bg-hueso">
  <div class="container-page py-16 sm:py-20">
    <div class="max-w-2xl">
      <h2 class="font-display text-2xl font-semibold text-tinta sm:text-3xl">{flows.title}</h2>
      <p class="mt-3 text-tinta-suave">{flows.subtitle}</p>
    </div>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        flows.items.map((flow) => (
          <li class="flex flex-col gap-3 border border-borde bg-hueso p-6">
            <span class="w-fit border border-tinta px-2 py-0.5 font-mono text-xs font-medium text-tinta">
              {flow.code}
            </span>
            <h3 class="font-display text-lg font-semibold text-tinta">{flow.name}</h3>
            <p class="text-sm leading-relaxed text-tinta-suave">{flow.resolves}</p>
            <p class="mt-auto border-t border-borde pt-3 font-mono text-xs text-senal">
              {flow.audience}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
