---
import { problem } from "../content/site";
---

<section id="problema" class="border-b border-borde bg-hueso">
  <div class="container-page py-16 sm:py-20">
    <h2 class="max-w-2xl font-display text-2xl font-bold text-tinta sm:text-3xl">
      {problem.title}
    </h2>

    <dl class="mt-10 grid gap-8 sm:grid-cols-3 sm:gap-6">
      {
        problem.stats.map((stat, index) => (
          <div class="border-t-2 border-tinta pt-4">
            <dt class="sr-only">{stat.description}</dt>
            <dd>
              <p
                class:list={[
                  "font-mono text-4xl font-semibold sm:text-5xl",
                  index === 1 ? "text-urgencia" : "text-tinta",
                ]}
              >
                {stat.value}
              </p>
              <p class="mt-2 text-sm leading-relaxed text-tinta-suave" aria-hidden="true">{stat.description}</p>
            </dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-6 font-mono text-xs text-tinta-suave">{problem.sources}</p>
  </div>
</section>
