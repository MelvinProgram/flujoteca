---
import { problem } from "../content/site";
---

<section id="problema" class="reveal border-b border-borde bg-hueso">
  <div class="container-page py-16 sm:py-20">
    <h2 class="max-w-2xl font-display text-2xl font-bold text-tinta sm:text-3xl">
      {problem.title}
    </h2>

    <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-12">
      <div>
        <p class="text-tinta-suave">{problem.intro}</p>
        <ul class="mt-4 space-y-3">
          {
            problem.tasks.map((task) => (
              <li class="flex items-start gap-3 text-tinta">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-urgencia" aria-hidden="true" />
                {task}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        {
          problem.stats.map((stat) => (
            <figure class="border-t-2 border-tinta pt-4">
              <p class="font-mono text-5xl font-semibold text-tinta sm:text-6xl">{stat.value}</p>
              <figcaption class="mt-2 text-sm leading-relaxed text-tinta-suave">
                {stat.description}
              </figcaption>
            </figure>
          ))
        }
        <p class="mt-4 font-mono text-xs text-tinta-suave">
          <a
            href={problem.source.href}
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-2 hover:text-senal"
          >
            {problem.source.label}
          </a>
        </p>
      </div>
    </div>
  </div>
</section>
