---
import "../styles/global.css";
import { site, stack } from "../content/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description = site.description, image = "/og-image.png", noindex = false } = Astro.props;
const ogImage = new URL(image, Astro.site);

const pageTitle = title ? `${title} · ${site.name}` : site.seoTitle;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const orgId = `${site.url}/#organization`;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": orgId,
  name: site.name,
  url: site.url,
  logo: new URL("/logo.png", Astro.site).href,
  email: site.contact.email,
  description: site.description,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Valdemoro",
    addressRegion: "Madrid",
    addressCountry: "ES",
  },
  areaServed: { "@type": "AdministrativeArea", name: "Sur de la Comunidad de Madrid" },
  knowsAbout: [...stack, "Automatización de procesos", "Inteligencia artificial"],
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Automatización de procesos empresariales e integración de IA",
  serviceType: "Automatización de procesos empresariales",
  description: `Diseño e implementación de flujos de trabajo automatizados para asesorías y gestorías, con ${stack.join(", ")}.`,
  provider: { "@id": orgId },
  areaServed: { "@type": "AdministrativeArea", name: "Sur de la Comunidad de Madrid" },
  audience: { "@type": "Audience", audienceType: "Asesorías y gestorías" },
};

---

<!doctype html>
<html lang="es">
  <head>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("flujoteca-theme");
        var dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <script is:inline>
      // Oculta los bloques de las secciones hasta que motion.ts los revele.
      // Sin movimiento reducido, y con un seguro por si el script no llega a cargar.
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var root = document.documentElement;
        root.classList.add("motion-pending");
        setTimeout(function () {
          if (!window.__motionReady) root.classList.remove("motion-pending");
        }, 4000);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </head>
  <body class="bg-hueso text-tinta antialiased">
    <slot />
    <script>
      import { initClickTracking } from "../lib/track";
      initClickTracking();
      import "../scripts/motion";
    </script>
  </body>
</html>
